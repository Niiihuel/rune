  "observations": [
    {
      "id": "N001",
      "summary": "Linux NativePermissions::OpenSettings is a one-byte RET; the inspected HasAuthorization implementation returns a constant authorized result.",
      "rea_evidence_ids": [
        "ev_7eb3c1e30ea3cf78160b24b2ead498bf67b1cfd49513772d923a833ba390838b",
        "ev_f7a1a6b086a84ef098d85c7faf784fe35bbe779ee3698271a78ae9e8d78942f4"
      ],
      "supplemental_record_ids": [],
      "boundary": "Does not establish actual OS permission state or behavior on other platforms."
    },
    {
      "id": "N002",
      "summary": "Input registration reads press/release and focused/blurred options, dispatches through a worker executor and replaces an existing registration with the same ID.",
      "rea_evidence_ids": [
        "ev_79fa2212483a379fc20b7b83255c04e8ffabd49165d7fb565a68a21273a29b55",
        "ev_20efd9e83d17e5f2501b5d2c3a46fd45ce32688108f7061e63371e81ae6c7f6a"
      ],
      "supplemental_record_ids": [],
      "boundary": "Does not prove global input delivery. Separate Linux functions are stubs."
    },
    {
      "id": "N003",
      "summary": "Linux PlatformWatchDevice and ServiceSendRegisterEvent are empty RET functions.",
      "rea_evidence_ids": [
        "ev_99b176d490642a566aeaa4e003ea3a9b3f3bb4c64d01451734d0324e58cea0e7",
        "ev_35e6afced9e1a6b951b5c0854a4d071bd6111bb8ca0cadca4c17362cd7f23d94"
      ],
      "supplemental_record_ids": [],
      "boundary": "Other Electron/native input routes were not established by these functions."
    },
    {
      "id": "N004",
      "summary": "Wayland idle handling binds ext_idle_notifier_v1 and wl_seat, checks availability, records idle/resume events with a monotonic clock and mutex, and computes idle duration from the configured threshold plus elapsed time.",
      "rea_evidence_ids": [
        "ev_6abbd1a91accee756e49b65cdda6b368be4f878c06a37993875cae9af5051cc7",
        "ev_651cb1351678797dd94b521284e428d824c0dcf69df0ed67696a263dec0c9290",
        "ev_f041c6a30165d76ae7ecac46d74b3a17c914a5935288bdcd2f199be88c81327e",
        "ev_68fffb03379caa40e09c0079b27301def38b71b124ffa672f77bc994b7e45da1",
        "ev_69a901c1b183a71ccfdde5ccfa491d653913ae54884172094ec7ecacd7eb1a60"
      ],
      "supplemental_record_ids": [],
      "boundary": "No current-compositor protocol availability or remote presence transition was observed."
    },
    {
      "id": "N005",
      "summary": "SystemOpen launches xdg-open through fork/execlp and waits using waitpid. Calling this implementation can block its caller.",
      "rea_evidence_ids": [
        "ev_c4a6a700c2b5e529484322bc14bc1aad8a8909765c580d5856ad155b1fe4e4ea"
      ],
      "supplemental_record_ids": [],
      "boundary": "Static evidence only; no target execution."
    },
    {
      "id": "N006",
      "summary": "Input-mode parsing handles VAD threshold, leading/trailing timing, automatic threshold and PTT release delay. SetPTTActive updates key state separately from connection settings.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_01",
        "supplemental_voice_06"
      ],
      "boundary": "Static evidence only; no target execution."
    },
    {
      "id": "N007",
      "summary": "Voice-processing settings independently address echo cancellation, noise suppression/cancellation, gain control and echo-reference mode. Transport settings additionally select devices, input/output volumes, ducking, idle jitter flushing and mixer options.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_02",
        "supplemental_voice_15"
      ],
      "boundary": "Referenced option names and native control paths were observed; signal quality and provider support remain untested."
    },
    {
      "id": "N008",
      "summary": "SetLoopback applies voice-processing settings before enabling local loopback and conditionally provides the voice callback. The loopback send/receive streams use WebRTC; the inspected playback path configures Opus at 48 kHz with two channels.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_03",
        "supplemental_voice_08",
        "supplemental_voice_11",
        "supplemental_voice_12"
      ],
      "boundary": "Mode-specific send branches also include PCMU at 8 kHz. This is not evidence that every probe or network call always uses stereo Opus."
    },
    {
      "id": "N009",
      "summary": "Input/output device-change handlers tail-jump to record/playback stream rebuilding. Existing send/receive streams are destroyed before replacements are created.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_09",
        "supplemental_voice_10",
        "supplemental_voice_11",
        "supplemental_voice_12"
      ],
      "boundary": "The five-byte handler extents are distinct from their tail-jump destinations; the decompiler can inline those destinations."
    },
    {
      "id": "N010",
      "summary": "The selected LoopbackAudioStream::OnCaptureData override is a one-byte RET, while separate stream construction and callbacks perform loopback work.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_13"
      ],
      "boundary": "An override name alone is not evidence of an implemented audio-data path."
    },
    {
      "id": "N011",
      "summary": "Connection settings are copied into queued work; fast UDP reconnect also uses SafeQueueWork. Device, no-input, audio-module-error and video-initialization callback boundaries exist separately.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_04",
        "supplemental_voice_05",
        "supplemental_voice_07",
        "supplemental_voice_17",
        "supplemental_voice_18",
        "supplemental_voice_21"
      ],
      "boundary": "No callback delivery, reconnect success or provider handshake was observed."
    },
    {
      "id": "N012",
      "summary": "Native capture-picker delegation reaches a Linux backend that checks picker availability, requests a window/screen picker with a callback, reports request failure and offers a separate close-session operation. Screen/window preview wrappers are separate.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_14",
        "supplemental_voice_19",
        "supplemental_voice_20",
        "supplemental_picker_boundary"
      ],
      "boundary": "Linux picker boundary is supplementary objdump evidence at original linked addresses 0x448300/0x448310. No picker or capture session was executed."
    },
    {
      "id": "N013",
      "summary": "Media-filter parsing validates target type, stream ID for stream targets and image width/height/pixel format/data. It distinguishes invalid image formats and exposes segmentation/blur parameters.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_22"
      ],
      "boundary": "No model, image, proprietary resource or implementation code was copied into RUNE."
    },
    {
      "id": "N014",
      "summary": "Connection statistics distinguish inbound/outbound audio/video, packet loss, codec implementation, frame rates/drops, resolution, freezes/pauses, bandwidth/RTT and CPU/bandwidth limitations.",
      "rea_evidence_ids": [],
      "supplemental_record_ids": [
        "supplemental_voice_23"
      ],
      "boundary": "These are static statistics construction paths, not live metrics or proof of any exact visible diagnostics panel."
    }
  ],
